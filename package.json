{
  "name": "stadiaref",
  "version": "3.0.0-dev",
  "description": "An address for every part of the screen. StadiaRef shows data-ref attributes as labels you can point at and copy. For websites, web apps and PWAs.",
  "main": "dist/stadiaref.min.js",
  "unpkg": "dist/stadiaref.min.js",
  "jsdelivr": "dist/stadiaref.min.js",
  "files": [
    "dist/stadiaref.min.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "esbuild src/overlay/index.js --bundle --minify --outfile=dist/stadiaref.min.js --format=iife",
    "build:wp": "bash scripts/build-wp-zip.sh",
    "dev": "esbuild src/overlay/index.js --bundle --outfile=dist/stadiaref.js --format=iife --watch",
    "test": "npm run build && npm run test:unit && npm run test:browser",
    "test:unit": "node --test 'test/unit/**/*.test.mjs'",
    "test:browser": "playwright test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "data-ref",
    "stadiaref",
    "overlay",
    "labels",
    "qa",
    "design-review",
    "wireframe",
    "web-app",
    "pwa",
    "wordpress",
    "astro",
    "vite"
  ],
  "author": "Seguru Digital <hello@seguru.digital>",
  "license": "MIT",
  "homepage": "https://github.com/segurudigital/stadiaref#readme",
  "bugs": {
    "url": "https://github.com/segurudigital/stadiaref/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/segurudigital/stadiaref.git"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.20.2"
  }
}
