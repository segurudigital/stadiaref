{
  "name": "stadiaref",
  "version": "3.0.0",
  "description": "An address for every part of the screen. StadiaRef shows data-ref attributes as labels you can point at and copy. For websites, web apps and PWAs.",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./core": {
      "types": "./types/core.d.ts",
      "import": "./dist/core.mjs"
    },
    "./astro": {
      "types": "./types/astro.d.ts",
      "import": "./dist/astro.mjs"
    },
    "./vite": {
      "types": "./types/vite.d.ts",
      "import": "./dist/vite.mjs"
    },
    "./dist/stadiaref.min.js": "./dist/stadiaref.min.js",
    "./package.json": "./package.json"
  },
  "unpkg": "dist/stadiaref.min.js",
  "jsdelivr": "dist/stadiaref.min.js",
  "files": [
    "dist/*.mjs",
    "dist/stadiaref.min.js",
    "types",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:wp": "bash scripts/build-wp-zip.sh",
    "build:wp-bridge": "bash scripts/build-wp-bridge.sh",
    "dev": "node scripts/build.mjs --watch",
    "test": "npm run build && npm run test:unit && npm run test:browser",
    "test:unit": "node --test 'test/unit/**/*.test.mjs'",
    "test:browser": "playwright test",
    "size": "node scripts/check-size.mjs",
    "prepublishOnly": "npm run build",
    "test:integration": "npm run build && node test/integration/run.mjs",
    "test:wordpress": "npm run build:wp && npm run build:wp-bridge && npm install --prefix test/integration/wordpress --no-package-lock --no-audit --no-fund && node test/integration/wordpress/run.mjs"
  },
  "keywords": [
    "data-ref",
    "stadiaref",
    "overlay",
    "labels",
    "qa",
    "design-review",
    "wireframe",
    "web-app",
    "pwa",
    "wordpress",
    "astro",
    "vite"
  ],
  "author": "Seguru Digital <hello@seguru.digital>",
  "license": "MIT",
  "homepage": "https://github.com/segurudigital/stadiaref#readme",
  "bugs": {
    "url": "https://github.com/segurudigital/stadiaref/issues"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/segurudigital"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/segurudigital/stadiaref.git"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.20.2"
  },
  "peerDependencies": {
    "astro": ">=7",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
